name: mibici-equipo09

python_env: python_env.yaml

# Los valores por defecto de train son los de mibici/config.py; tests/test_mlproject.py
# falla si alguno se desalinea. Rutas, fechas, semilla, umbrales y experimento no se
# repiten aquí: el código los lee de mibici/config.py.
entry_points:
  ingest:
    command: "python -m mibici.dataset"

  baseline:
    parameters:
      pregunta: {type: string, default: "all"}
    command: "python -m mibici.modeling.train --pregunta {pregunta}"

  train:
    parameters:
      pregunta: {type: string}
      modelo: {type: string}
      learning_rate: {type: float, default: 0.05}
      max_iter: {type: int, default: 150}
      max_leaf_nodes: {type: int, default: 31}
      l2_regularization: {type: float, default: 0.0}
      alpha: {type: float, default: 1.0}
      C: {type: float, default: 1.0}
      n_clusters: {type: int, default: 5}
      batch_size: {type: int, default: 128}
      estaciones: {type: string, default: "todas"}
    command: >-
      python -m mibici.modeling.candidates train
      --pregunta {pregunta}
      --modelo {modelo}
      --learning-rate {learning_rate}
      --max-iter {max_iter}
      --max-leaf-nodes {max_leaf_nodes}
      --l2-regularization {l2_regularization}
      --alpha {alpha}
      --C {C}
      --n-clusters {n_clusters}
      --batch-size {batch_size}
      --estaciones {estaciones}

  search:
    parameters:
      pregunta: {type: string}
    command: "python -m mibici.modeling.candidates search --pregunta {pregunta}"

  register:
    command: "python -m mibici.modeling.registry"

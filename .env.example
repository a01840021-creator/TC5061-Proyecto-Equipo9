# Plantilla de variables de entorno para el proyecto MiBici (Equipo 9)
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
# NUNCA agregues claves privadas, contraseñas o tokens de acceso a este archivo.

# Configuración del servidor de MLflow Tracking
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=mibici-equipo09

# Semilla global para reproducibilidad (scikit-learn, numpy, deepchecks)
SEMILLA=42

# Rutas de datos locales (relativas a la raíz del proyecto)
RUTA_DATOS_RAW=data/raw
RUTA_DATOS_PROCESSED=data/processed

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Plantilla de variables de entorno para MiBici. Para desarrollo local:
#   cp .env.example .env
# mibici/config.py carga .env con python-dotenv. Si una variable no está definida, el código
# usa el valor que aparece aquí. No agregues claves, contraseñas ni tokens a este archivo.

# Servidor de MLflow Tracking. La leen mibici/config.py, mibici/modeling/candidates.py
# y mibici/modeling/registry.py.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Nivel mínimo de los mensajes de loguru (DEBUG, INFO, WARNING, ERROR).
LOGURU_LEVEL=INFO

# Color en los mensajes de loguru. 0, false, no u off lo desactivan, por ejemplo para
# guardar notebooks sin códigos ANSI.
LOGURU_COLORIZE=True
